# Copy to .env and fill in only the alert channels you use.
# Real environment variables always take precedence over .env values.

SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

ALERT_EMAIL_RECIPIENT=
SMTP_HOST=localhost

# Comma-separated days before expiry that trigger alerts
ALERT_DAYS=30,14,7,1
